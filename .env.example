# Public RPC used for browser wallet discovery/read calls.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SITE_URL=https://www.pumpfunfantasy.xyz
PUMP_FANTASY_ALLOWED_ORIGINS=https://www.pumpfunfantasy.xyz,https://pump-fantasy-pf.vercel.app
NEXT_PUBLIC_FANTASY_CA=

# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=
PF_SESSION_SECRET=
SOLANA_RPC_URL=
FANTASY_MINT_ADDRESS=
# Whole-token minimum, not base units. Entries require at least 500,000 FANTASY.
FANTASY_MINIMUM_TOKENS=500000
PF_ACTIVE_SEASON_ID=
PF_DATA_INGEST_SECRET=
PF_DAILY_PRIZE_LAMPORTS=
PF_PRIZE_WALLET_ADDRESS=
# Automatic SOL awards are fail-closed until all four payout settings are deliberately configured.
PF_AUTO_PAYOUT_ENABLED=false
PF_PAYOUT_NETWORK=mainnet-beta
PF_AUTO_PAYOUT_MAX_AWARD_LAMPORTS=
PF_AUTO_PAYOUT_MAX_SEASON_LAMPORTS=
# Add the Solana CLI 64-byte JSON keypair array directly as a Railway secret. Never commit or share it.
PF_PAYOUT_SIGNER_KEYPAIR_JSON=

# Relaunch: variable daily prizes from confirmed creator fees, not a fixed SOL amount.
PF_REWARD_MODE=creator-fees
PF_FEE_COLLECTION_ENABLED=false
PF_CREATOR_WALLET_ADDRESS=
# The new creator wallet must be dedicated to this token; its vault aggregates fees.
PF_CREATOR_WALLET_DEDICATED=true
# Alternative to the JSON keypair: base58 private key, server-only on Railway.
PF_CREATOR_PRIVATE_KEY=
